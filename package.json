{
  "name": "ml-spms-unical",
  "version": "1.0.0",
  "description": "Machine Learning-Based Student Performance Monitoring System - University of Calabar CS Department",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node database/seed.js",
