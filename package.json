    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ml-cart": "^2.1.1",
    "ml-logistic-regression": "^2.0.0",
    "ml-matrix": "^6.15.0",
    "ml-random-forest": "^2.1.0",
    "morgan": "^1.10.1",
    "mysql2": "^3.16.2",
    "nodemailer": "^6.10.1"
  },
