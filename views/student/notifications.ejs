<%- include('../partials/header') %>

<div class="mlspms-app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="mlspms-main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="mlspms-content-body">
      <%- include('../partials/flash') %>

      <div class="mlspms-card">
        <div class="mlspms-card-header">
          <span class="mlspms-card-title">Academic Early Warning Alerts & Advisories</span>
          <span class="mlspms-badge mlspms-badge-neutral">Auto-Dispatched</span>
        </div>
        <div class="mlspms-card-body">
          <p style="font-size: 13px; color: #64748b; margin-bottom: 20px;">
            These notifications are automatically generated by the department's Machine Learning Prediction Engine when your performance metrics fall into Moderate or High risk categories.
          </p>

          <% if (notifications && notifications.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 16px;">
              <% notifications.forEach(function(n) { %>
                <div style="background-color: <%= n.risk_level === 'high' ? 'var(--mlspms-risk-high-bg)' : 'var(--mlspms-risk-mod-bg)' %>; border: 1px solid <%= n.risk_level === 'high' ? 'var(--mlspms-risk-high-border)' : 'var(--mlspms-risk-mod-border)' %>; border-left: 5px solid <%= n.risk_level === 'high' ? 'var(--mlspms-risk-high-solid)' : 'var(--mlspms-risk-mod-solid)' %>; padding: 16px; border-radius: var(--mlspms-radius-sm);">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span class="mlspms-badge <%= n.risk_level === 'high' ? 'mlspms-badge-high' : 'mlspms-badge-moderate' %>">
                      <%= n.risk_level.toUpperCase() %> RISK ALERT
                    </span>
                    <span style="font-size: 11px; color: #64748b;">
                      <%= new Date(n.timestamp).toLocaleString('en-GB') %>
                    </span>
                  </div>
                  <div style="font-size: 13px; color: #1e293b; line-height: 1.5;">
                    <%= n.message %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div style="text-align: center; padding: 40px 20px; color: #64748b;">
              <h4 style="font-size: 15px; color: #166534; margin-bottom: 4px;">No Active Risk Warnings</h4>
              <p style="font-size: 13px;">Your continuous academic standing is currently optimal.</p>
            </div>
          <% } %>
        </div>
      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>
