<%- include('../partials/header') %>

<div class="mlspms-app-wrapper">
  <%- include('../partials/sidebar') %>

  <div class="mlspms-main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="mlspms-content-body">
      <%- include('../partials/flash') %>

      <div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; margin-bottom: 24px;">
        <!-- Course Session Attendance Register -->
        <div class="mlspms-card" style="margin-bottom: 0;">
          <div class="mlspms-card-header">
            <span class="mlspms-card-title">Class & Lab Session Attendance Registry</span>
            <span class="mlspms-badge mlspms-badge-neutral">UNICAL Minimum: 75%</span>
          </div>
          <div class="mlspms-card-body">
            <p style="font-size: 13px; color: #64748b; margin-bottom: 16px;">
              Mark class or laboratory session attendance. Recording attendance automatically updates the student's attendance rate and triggers real-time ML risk re-evaluation.
            </p>

            <form action="/lecturer/attendance/entry" method="POST">
              <div class="mlspms-form-row" style="margin-bottom: 16px;">
                <div>
                  <label class="mlspms-label" for="course_code">Course</label>
                  <select name="course_code" id="course_code" class="mlspms-select" required>
                    <% courses.forEach(function(c) { %>
                      <option value="<%= c.course_code %>" <%= selectedCourse === c.course_code ? 'selected' : '' %>>
                        <%= c.course_code %> — <%= c.title %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <div>
                  <label class="mlspms-label" for="session_date">Session Date</label>
                  <input 
                    type="date" 
                    id="session_date" 
                    name="session_date" 
                    class="mlspms-input" 
                    value="<%= todayDate %>" 
                    required
                  >
                </div>
              </div>

              <div class="mlspms-table-responsive" style="max-height: 380px; overflow-y: auto; margin-bottom: 16px; border: 1px solid var(--mlspms-border-color); border-radius: var(--mlspms-radius-sm);">
                <table class="mlspms-table">
                  <thead style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                      <th>Matric No.</th>
                      <th>Student Full Name</th>
                      <th style="text-align: center; width: 140px;">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% students.forEach(function(s) { %>
                      <tr>
                        <td><strong><%= s.matric_no %></strong></td>
                        <td><%= s.full_name %></td>
                        <td style="text-align: center;">
                          <label style="margin-right: 10px; cursor: pointer; font-size: 12px;">
                            <input type="radio" name="attendance[<%= s.student_id %>]" value="present" checked> Present
                          </label>
                          <label style="cursor: pointer; font-size: 12px; color: #dc2626;">
                            <input type="radio" name="attendance[<%= s.student_id %>]" value="absent"> Absent
                          </label>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <button type="submit" class="mlspms-btn mlspms-btn-primary" style="width: 100%; padding: 10px;">
                Record Session Attendance & Run Prediction Engine
              </button>
            </form>
          </div>
        </div>

        <!-- Attendance Stats / Recent Sessions -->
        <div class="mlspms-card" style="margin-bottom: 0;">
          <div class="mlspms-card-header">
            <span class="mlspms-card-title">Recent Attendance Log</span>
          </div>
          <div class="mlspms-card-body" style="max-height: 520px; overflow-y: auto; padding: 0;">
            <table class="mlspms-table" style="font-size: 12px;">
              <thead>
                <tr>
                  <th>Student</th>
                  <th>Course</th>
                  <th>Date</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentAttendance && recentAttendance.length > 0) { %>
                  <% recentAttendance.forEach(function(a) { %>
                    <tr>
                      <td>
                        <strong><%= a.matric_no %></strong><br>
                        <span style="font-size: 11px; color: #64748b;"><%= a.full_name %></span>
                      </td>
                      <td><%= a.course_code %></td>
                      <td><%= new Date(a.session_date).toISOString().split('T')[0] %></td>
                      <td>
                        <% if (a.status === 'present') { %>
                          <span class="mlspms-badge mlspms-badge-low" style="padding: 2px 6px; font-size: 10px;">
                            PRESENT
                          </span>
                        <% } else { %>
                          <span class="mlspms-badge mlspms-badge-high" style="padding: 2px 6px; font-size: 10px;">
                            ABSENT
                          </span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" style="text-align: center; padding: 20px; color: #64748b;">
                      No attendance sessions registered yet.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<%- include('../partials/footer') %>
